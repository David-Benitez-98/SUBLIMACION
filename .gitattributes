# Normalizar finales de línea para evitar cambios masivos al alternar Windows/Linux.
* text=auto
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Recursos binarios
*.avif binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.rar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
